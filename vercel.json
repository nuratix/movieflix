{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/catalog",
      "destination": "/api/content?endpoint=home"
    },
    {
      "source": "/api/home",
      "destination": "/api/content?endpoint=home"
    },
    {
      "source": "/api/movies",
      "destination": "/api/content?endpoint=movies"
    },
    {
      "source": "/api/tv-series",
      "destination": "/api/content?endpoint=tv-series"
    },
    {
      "source": "/api/animation",
      "destination": "/api/content?endpoint=animation"
    },
    {
      "source": "/api/shots",
      "destination": "/api/content?endpoint=shots"
    },
    {
      "source": "/api/reels",
      "destination": "/api/content?endpoint=shots"
    },
    {
      "source": "/api/search",
      "destination": "/api/content?endpoint=search"
    },
    {
      "source": "/api/detail/:slug",
      "destination": "/api/content?endpoint=detail&slug=:slug"
    },
    {
      "source": "/api/stream/:id/captions",
      "destination": "/api/content?endpoint=captions&id=:id"
    },
    {
      "source": "/api/stream/:id",
      "destination": "/api/content?endpoint=stream&id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/assets/icon.png",
      "destination": "/api/icon"
    },
    {
      "source": "/assets/icon-512.png",
      "destination": "/api/icon?size=512"
    },
    {
      "source": "/assets/og-banner.png",
      "destination": "/api/og-image"
    },
    {
      "source": "/favicon.png",
      "destination": "/api/favicon"
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/favicon?format=ico"
    },
    {
      "source": "/assets/favicon.png",
      "destination": "/api/favicon"
    },
    {
      "source": "/icon.png",
      "destination": "/api/icon"
    },
    {
      "source": "/og-image.png",
      "destination": "/api/og-image"
    },
    {
      "source": "/download",
      "destination": "/download/index.html"
    },
    {
      "source": "/apk",
      "destination": "/apk/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/dmca",
      "destination": "/dmca/index.html"
    },
    {
      "source": "/maintenance",
      "destination": "/maintenance/index.html"
    },
    {
      "source": "/donate",
      "destination": "/donate/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/movieflix.apk",
      "destination": "/api/download"
    },
    {
      "source": "/movieflix-latest.apk",
      "destination": "/api/download"
    },
    {
      "source": "/downloads/movieflix.apk",
      "destination": "/api/download"
    },
    {
      "source": "/app.apk",
      "destination": "/api/download"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico|sitemap\\.xml|robots\\.txt|404\\.html|.*\\.(?:png|jpg|jpeg|gif|svg|ico|webp|mp4|json|js|css|ttf|woff|woff2|apk)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*\\.png)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"movieflix-v1.1.8.apk\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
