{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/catalog",
      "destination": "/api/content?endpoint=home"
    },
    {
      "source": "/api/home",
      "destination": "/api/content?endpoint=home"
    },
    {
      "source": "/api/movies",
      "destination": "/api/content?endpoint=movies"
    },
    {
      "source": "/api/tv-series",
      "destination": "/api/content?endpoint=tv-series"
    },
    {
      "source": "/api/animation",
      "destination": "/api/content?endpoint=animation"
    },
    {
      "source": "/api/search",
      "destination": "/api/content?endpoint=search"
    },
    {
      "source": "/api/detail/:slug",
      "destination": "/api/content?endpoint=detail&slug=:slug"
    },
    {
      "source": "/api/stream/:id/captions",
      "destination": "/api/content?endpoint=captions&id=:id"
    },
    {
      "source": "/api/stream/:id",
      "destination": "/api/content?endpoint=stream&id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/assets/icon.png",
      "destination": "/api/icon"
    },
    {
      "source": "/assets/icon-512.png",
      "destination": "/api/icon?size=512"
    },
    {
      "source": "/assets/og-banner.png",
      "destination": "/api/og-image"
    },
    {
      "source": "/icon.png",
      "destination": "/api/icon"
    },
    {
      "source": "/og-image.png",
      "destination": "/api/og-image"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico|sitemap\\.xml|robots\\.txt|404\\.html|.*\\.(?:png|jpg|jpeg|gif|svg|ico|webp|mp4|json|js|css|ttf|woff|woff2)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*\\.png)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
